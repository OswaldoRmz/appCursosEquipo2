<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".Vista.VerRegistrosActivity">

    <LinearLayout
        android:id="@+id/principal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F5F7FA"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Barra superior de navegación -->
        <LinearLayout
            android:id="@+id/barra"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#085394"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <!-- Flecha de regreso -->
            <ImageView
                android:id="@+id/btnVolver"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Regresar"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <!-- Título de la pantalla -->
            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="ESTADO DE INSCRIPCIONES"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp">

            <!-- Filtro para las carreras -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFiltro"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <!-- Imagen para la carrera -->
                    <ImageView
                        android:id="@+id/imgCarrera"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Imagen de carrera"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_manage" />

                    <!-- Selector de carrera -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Filtrar por carrera:"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/snpCarreras"
                            android:layout_width="match_parent"
                            android:layout_height="42dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Contador de Total Registros -->
            <TextView
                android:id="@+id/txtTotalRegistros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:text="Total: 285"
                android:textColor="#555555"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Lista de inscripciones por curso -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRegistros"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                android:scrollbars="vertical" />

            <!-- Botón inferior para regresar al catálogo -->
            <Button
                android:id="@+id/btnVolverCatalogo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#085394"
                android:text="VOLVER AL CATÁLOGO"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>